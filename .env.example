# FlowOps Environment Configuration
# Learn from every incident.

# Groq LLM Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Hindsight Memory Configuration
# Stores persistent organizational incident experience in memory bank 'flowops-sre-memory'
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=flowops-sre-memory
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io/v1

# Database Configuration (supports PostgreSQL and SQLite fallback)
# Default: local SQLite for turnkey development
DATABASE_URL=sqlite:///./flowops.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/flowops
